{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim-schemas/ack/v1.json",
  "title": "ack claim (v1)",
  "type": "object",
  "properties": {
    "type": {
      "const": "ack"
    },
    "claimSchema": {
      "const": "ack/v1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,30}$",
      "description": "Cluster name. Lower-case letters, digits and hyphens, 3-31 characters, must start with a letter.",
      "x-maps-to": "cluster_name"
    },
    "size": {
      "type": "string",
      "description": "T-shirt size. The platform resolves it to a worker instance type and node count; a business unit never names an instance type directly. Changing what a size means is a sizing-map change and needs no manifest edits.",
      "enum": [
        "large",
        "medium",
        "small"
      ],
      "x-resolves-to": {
        "large": {
          "worker_instance_type": "ecs.g6.2xlarge",
          "worker_count": 5
        },
        "medium": {
          "worker_instance_type": "ecs.g6.xlarge",
          "worker_count": 3
        },
        "small": {
          "worker_instance_type": "ecs.g6.large",
          "worker_count": 2
        }
      },
      "x-virtual": true
    },
    "namespaces": {
      "type": "array",
      "default": [],
      "description": "Kubernetes namespaces to create on the cluster."
    }
  },
  "required": [
    "type",
    "claimSchema",
    "name",
    "size"
  ],
  "additionalProperties": false,
  "x-module": {
    "name": "ack",
    "internal_variables": 8,
    "exposed_fields": 3
  }
}
